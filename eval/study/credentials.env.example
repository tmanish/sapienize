# Copy into ignored eval/.local/effectiveness/credentials.env and fill there.
# Load with: node --env-file=eval/.local/effectiveness/credentials.env ...
# Never paste real keys into chat or commit them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GPTZERO_API_KEY=
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
ORIGINALITY_API_KEY=
# Explicit account-supported model IDs; resolve/pin before freezing the run.
# With smoke-openrouter.json or pilot-openrouter.json, ALL three IDs must be
# OpenRouter catalog slugs (including the vendor prefix). Only OPENROUTER_API_KEY
# is needed for writing; OPENAI_API_KEY and ANTHROPIC_API_KEY can stay blank.
STUDY_OPENAI_MODEL=
STUDY_ANTHROPIC_MODEL=
STUDY_OPENROUTER_MODEL=
